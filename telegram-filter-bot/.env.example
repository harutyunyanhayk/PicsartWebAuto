# my.telegram.org -> API development tools -> create an app
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Session file name (created automatically after first login)
TG_SESSION_NAME=veolia_filter_session

# Channel to watch (username, without @, or full t.me link)
SOURCE_CHANNEL=VeoliaJur

# Where to deliver matching messages: "me" = your own Saved Messages,
# or a username/chat id/phone to send to instead.
TARGET_CHAT=me

# Comma-separated list of keywords to filter by (case-insensitive, substring match)
KEYWORDS=Առնո Բաբաջանյան,Օհանով
